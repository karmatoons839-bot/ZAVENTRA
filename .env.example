PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
# For local testing only. Set to your phone in international format, e.g. +91XXXXXXXXXX
OWNER_PHONE=
# Demo mode prints OTP to the server terminal. Do NOT expose demo mode publicly.
OTP_DEMO_MODE=true
# Real SMS OTP needs a provider and credentials; do not put secrets in frontend files.
SMS_PROVIDER=
SMS_API_KEY=
